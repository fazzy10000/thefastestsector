VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id

# In `npm run dev`, demo mode is ON by default (no login; localStorage data).
# Set to true to use real Firebase Auth + Firestore in local development.
# VITE_USE_FIREBASE=true

# Cloudinary (optional — enables image CDN with auto-resize/optimization)
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
